    residueTwoLen4EvenSumImpliesAllowed = true := by
  native_decide

theorem degreeList_eq_allowed_of_card_eq_four_of_residue_eq_two_of_maxDegree_le_six
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (hcard : Fintype.card V = 4)
    (hRes : residue G = 2) (hMax : G.maxDegree ≤ 6) :
    let s := (Finset.univ.val.map fun v : V => G.degree v).sort (· ≥ ·)
    s = [6, 6, 2, 2]
    ∨ s = [6, 6, 1, 1]
    ∨ s = [6, 5, 2, 1]
    ∨ s = [6, 4, 2, 2]
    ∨ s = [6, 4, 1, 1]
    ∨ s = [6, 3, 2, 1]
    ∨ s = [6, 2, 1, 1]
    ∨ s = [5, 5, 2, 2]
    ∨ s = [5, 5, 1, 1]
    ∨ s = [5, 4, 2, 1]
    ∨ s = [5, 3, 2, 2]
    ∨ s = [5, 3, 1, 1]
    ∨ s = [5, 2, 2, 1]
    ∨ s = [4, 4, 2, 2]
    ∨ s = [4, 4, 1, 1]
    ∨ s = [4, 3, 2, 1]
    ∨ s = [4, 2, 1, 1]
    ∨ s = [3, 3, 2, 2]
    ∨ s = [3, 3, 1, 1]
    ∨ s = [3, 2, 2, 1]
    ∨ s = [2, 2, 2, 2]
    ∨ s = [2, 2, 1, 1]
    ∨ s = [1, 1, 1, 1]
    ∨ s = [6, 6, 2, 0]
    ∨ s = [6, 6, 0, 0]
    ∨ s = [6, 5, 1, 0]
    ∨ s = [6, 4, 2, 0]
    ∨ s = [6, 4, 0, 0]
    ∨ s = [6, 3, 1, 0]
    ∨ s = [6, 2, 2, 0]
    ∨ s = [6, 2, 0, 0]
    ∨ s = [5, 5, 2, 0]
    ∨ s = [5, 5, 0, 0]
    ∨ s = [5, 4, 1, 0]
    ∨ s = [5, 3, 2, 0]
    ∨ s = [5, 3, 0, 0]
    ∨ s = [5, 2, 1, 0]
    ∨ s = [4, 4, 2, 0]
    ∨ s = [4, 4, 0, 0]
    ∨ s = [4, 3, 1, 0]
    ∨ s = [4, 2, 2, 0]
    ∨ s = [4, 2, 0, 0]
    ∨ s = [3, 3, 2, 0]
    ∨ s = [3, 3, 0, 0]
    ∨ s = [3, 2, 1, 0]
    ∨ s = [2, 2, 2, 0]
    ∨ s = [2, 2, 0, 0] := by
  classical
  let s := (Finset.univ.val.map fun v : V => G.degree v).sort (· ≥ ·)
  have hres : residueAux s = 2 := by
    change residueAux s = 2
    simpa [residue] using hRes
  have hlen : s.length = 4 := by
    rw [degreeList_length G, hcard]
  have hmax : ∀ x ∈ s, x ≤ 6 := by
    intro x hx
    exact (degreeList_forall_le_maxDegree G x hx).trans hMax
  have hpair : List.Pairwise (· ≥ ·) s := degreeList_pairwise G
  have hbool := residueTwoLen4EvenSumImpliesAllowed_eq_true
  have hp :
      (!decide (residueAux s = 2) || decide (s.sum % 2 = 1) ||
          allowedDegreeSeqfour s) =
        true :=
    forallNoninc_sound_nil 4 6 _
      (by simpa [residueTwoLen4EvenSumImpliesAllowed] using hbool)
      s hlen hmax hpair
  have hdisj : s.sum % 2 = 1 ∨ allowedDegreeSeqfour s = true := by
    simp only [hres, decide_true, Bool.not_true, Bool.false_or,
      Bool.or_eq_true, decide_eq_true_eq] at hp
    simpa using hp
  have heven : Even s.sum := by
    have := degree_sum_even G
    simpa [degreeList_sum G, s] using this
  have hallowed : allowedDegreeSeqfour s = true := by
    rcases hdisj with hodd | hallowed
    · rcases heven with ⟨k, hk⟩
      omega
    · exact hallowed
  have hmem : s ∈ allowedDegreeSeqfourList := by
    simpa [allowedDegreeSeqfour, decide_eq_true_eq] using hallowed
  simpa [allowedDegreeSeqfourList] using hmem


